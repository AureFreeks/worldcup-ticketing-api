{
  "compilerOptions": {
    "experimentalDecorators": true, //typeorm
    "emitDecoratorMetadata": true, //typeorm
    "baseUrl": "./src",
    "paths": {
      "@domain/*": [
        "domain/*"
      ],
      "@infrastructure/*": [
        "infrastructure/*"
      ],
      "@handlers/*": [
        "infrastructure/handlers/*"
      ],
      "@routes/*": [
        "infrastructure/routes/*"
      ],
      "@mock/*": [
        "infrastructure/mock/*"
      ],"@database/*": [
        "infrastructure/database/*"
      ],"@services/*": [
        "infrastructure/services/*"
      ]
    },
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}