{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@domain/*": [
        "domain/*"
      ],
      "@infrastructure/*": [
        "infrastructure/*"
      ],
      "@handlers/*": [
        "infrastructure/handlers/*"
      ],
      "@routes/*": [
        "infrastructure/routes/*"
      ],
      "@mock/*": [
        "infrastructure/mock/*"
      ]
    },
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
 
  }

}